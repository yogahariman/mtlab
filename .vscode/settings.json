{
  "C_Cpp.errorSquiggles": "disabled",
  "files.associations": {
    "*.mq5": "plaintext",
    "*.mqh": "plaintext"
  },
  "python.envFile": "${workspaceFolder}/.env",
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python-envs.pythonProjects": [
    {
      "path": ".",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip",
      "defaultInterpreterPath": "/home/rfi212/my_env/bin/python"
    }
  ],
  "[linux]": {
    "python.defaultInterpreterPath": "/home/rfi212/my_env/bin/python"
  },
  "[windows]": {
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
  },
  "terminal.integrated.env.linux": {
    "VIRTUAL_ENV": "/home/rfi212/my_env",
    "PATH": "/home/rfi212/my_env/bin:${env:PATH}"
  },
  "terminal.integrated.env.windows": {
    "MPLCONFIGDIR": "C:\\Users\\user\\mtlab\\.matplotlib"
  }
}
